# Copiar este archivo a backend/.env y completar los valores.
# NUNCA subir un archivo .env real (con credenciales) al repositorio.

# --- Entorno ---
ENVIRONMENT=development
DEBUG=true

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://jacobea:jacobea@localhost:5432/jacobea_dev

# --- Autenticación panel web ---
JWT_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- WhatsApp Business Cloud API (Meta) ---
# Ver docs/whatsapp.md para cómo obtener estos valores.
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- LLM (Anthropic / Claude) ---
# También se usa para leer fotos de comprobantes (Claude acepta imágenes) — Fase 2.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MAX_TOOL_ITERATIONS=6
CONVERSATION_HISTORY_LENGTH=20

# --- Transcripción de audio (OpenAI Whisper) — Fase 2 ---
# Si se deja vacío, el bot responde que todavía no puede transcribir audios (no falla en
# silencio ni simula una transcripción falsa).
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Google Calendar (cuenta de servicio con delegación de dominio) — Fase 3 ---
# Contenido completo del JSON de credenciales de la cuenta de servicio (no una ruta de
# archivo). Requiere que un administrador de Google Workspace autorice esa cuenta de
# servicio para delegación de dominio completo con el scope
# https://www.googleapis.com/auth/calendar. Si se deja vacío, las herramientas de
# calendario responden que no está configurado, en vez de simular disponibilidad o un
# evento falso. Ver docs/architecture.md (riesgo 8).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Rate limiting ---
RATE_LIMIT_WEBHOOK=30/minute
RATE_LIMIT_LOGIN=10/minute

# --- CORS (panel web) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
