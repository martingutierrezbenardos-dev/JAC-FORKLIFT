# Copiar este archivo a backend/.env y completar los valores.
# NUNCA subir un archivo .env real (con credenciales) al repositorio.

# --- Entorno ---
ENVIRONMENT=development
DEBUG=true

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://jacobea:jacobea@localhost:5432/jacobea_dev

# --- Autenticación panel web ---
JWT_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- WhatsApp Business Cloud API (Meta) ---
# Ver docs/whatsapp.md para cómo obtener estos valores.
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- LLM (Anthropic / Claude) ---
# También se usa para leer fotos de comprobantes (Claude acepta imágenes) — Fase 2.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MAX_TOOL_ITERATIONS=6
CONVERSATION_HISTORY_LENGTH=20

# --- Transcripción de audio (OpenAI Whisper) — Fase 2 ---
# Si se deja vacío, el bot responde que todavía no puede transcribir audios (no falla en
# silencio ni simula una transcripción falsa).
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Google Calendar y Gmail (cuenta de servicio con delegación de dominio) — Fase 3 / Fase 4 ---
# Contenido completo del JSON de credenciales de la cuenta de servicio (no una ruta de
# archivo). Requiere que un administrador de Google Workspace autorice esa cuenta de
# servicio para delegación de dominio completo con los scopes
# https://www.googleapis.com/auth/calendar (Fase 3) y, si además se quiere usar correo
# (Fase 4), https://www.googleapis.com/auth/gmail.readonly,
# https://www.googleapis.com/auth/gmail.compose y https://www.googleapis.com/auth/gmail.send.
# Es la misma variable para ambas integraciones. Si se deja vacío, las herramientas de
# calendario y correo responden que no están configuradas, en vez de simular disponibilidad,
# un evento o un correo falso. Ver docs/architecture.md (riesgo 8).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Almacenamiento de archivos (AWS S3) — Fase 4, opcional ---
# Si se deja vacío, las fotos de comprobantes se procesan y extraen igual, pero no se
# guardan de forma permanente (ver docs/whatsapp.md). AWS_ACCESS_KEY_ID/SECRET pueden
# dejarse vacíos si se usa un rol IAM (ej. desplegando en AWS) en vez de credenciales
# explícitas.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rate limiting ---
RATE_LIMIT_WEBHOOK=30/minute
RATE_LIMIT_LOGIN=10/minute

# --- CORS (panel web) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
